      "linux-arm64": "670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945",
      "linux-x64": "baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40"
    }
  },
  "maintenance": {
    "cron": "23 18 * * 6",
    "homeMaxGb": 30,
    "diagRetentionDays": 14
  },
  "secretsPolicy": "none",
  "roles": {
    "machineAdmin": "you",
    "repoAdmin": "you"
  },
  "tenant": {
    "name": "lab-ci",
    "user": "lab-ci",
    "group": "lab-ci",
    "uid": 1510,
    "gid": 1510,
    "home": "/home/lab-ci",
    "labelPrefix": "dev.example.lab-ci",
    "rootDir": "/opt/homeactions-lab",
    "runnerName": "lab-linux-1",
    "runnerLabels": [
      "lab-ci"
    ]
  },
  "host": {
    "os": "linux",
    "arch": "x64",
    "access": "ssh",
    "sshAlias": "labbox",
    "cores": 16,
    "memoryGb": 32,
    "diskEncryption": "luks",
    "autoRestart": true,
    "otherAdmins": [
      "ops"
    ]
  },
  "repo": {
    "slug": "example-lab/api",
    "visibility": "private",
    "forkPrs": false
  },
  "workflows": {
    "fallbackVariable": "LAB_CI_RUNNER",
    "selfValue": "lab",
    "selfLabel": "ci:lab",
    "hostedLabel": "ci:hosted",
