{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homeactions-ci/homeactions/skills/homeactions/kit/profile.schema.json",
  "title": "homeactions profile",
  "description": "Everything the interview learned, as data. The ONLY input to render.mjs. Lives in the user's repo at .homeactions/profile.json. Every field traces to an interview question or a read-only probe (references/interview.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenant", "host", "repo", "runner", "workflows", "stack", "caps", "services", "ports", "isolation", "cotenant", "diskFloorGb", "maintenance", "secretsPolicy", "watchdog", "roles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tenant": {
      "description": "The dedicated, non-admin CI user and the names of everything installed for it. All names are namespaced so a second tenant can coexist.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "user", "group", "uid", "gid", "home", "labelPrefix", "rootDir", "runnerName", "runnerLabels"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$", "description": "Short tenant id; shown in hook banners as homeactions[<name>]." },
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{1,30}$" },
        "group": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{1,30}$" },
        "uid": { "type": "integer", "minimum": 401, "maximum": 60000 },
        "gid": { "type": "integer", "minimum": 401, "maximum": 60000 },
        "home": { "type": "string", "pattern": "^/(Users|home|var/lib)/[a-z_][a-z0-9_-]{1,30}$" },
        "labelPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$", "description": "Reverse-DNS prefix for launchd labels / systemd unit names, e.g. com.example.ci." },
        "rootDir": { "type": "string", "pattern": "^/(Library|opt|etc)/[A-Za-z0-9._-]+$", "description": "Root-owned directory holding hooks and config, outside the runner directory." },
        "runnerName": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "runnerLabels": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" } }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "access", "cores", "memoryGb", "diskEncryption"],
      "properties": {
        "os": { "enum": ["macos", "linux"] },
        "arch": { "enum": ["arm64", "x64"] },
        "access": { "enum": ["local", "ssh"] },
        "sshAlias": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Host alias from the user's ~/.ssh/config. Never an IP or a user@host string." },
        "cores": { "type": "integer", "minimum": 1 },
        "memoryGb": { "type": "number", "minimum": 1 },
        "diskEncryption": { "enum": ["filevault", "luks", "none", "unknown"] },
        "autoRestart": { "type": ["boolean", "null"] },
        "otherAdmins": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,30}$" }, "description": "Existing human/admin accounts whose homes the tenant must not read (deny-ACE on macOS)." }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "visibility", "forkPrs"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
        "visibility": { "enum": ["private", "internal", "public"] },
        "forkPrs": { "type": "boolean", "description": "Whether workflows run for PRs from forks. Public + fork PRs => self-hosted is refused for those workflows." }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "osx-arm64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "osx-x64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "linux-arm64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "linux-x64": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallbackVariable", "selfValue", "selfLabel", "hostedLabel", "hostedOnlyJobs"],
      "properties": {
        "fallbackVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,60}$", "description": "Repo variable that switches jobs onto the self-hosted runner (value = selfValue)." },
        "selfValue": { "type": "string", "pattern": "^[a-z0-9-]{2,30}$" },
        "selfLabel": { "type": "string", "pattern": "^[a-z0-9:._-]{2,40}$", "description": "PR label forcing self-hosted." },
        "hostedLabel": { "type": "string", "pattern": "^[a-z0-9:._-]{2,40}$", "description": "PR label forcing GitHub-hosted." },
        "hostedOnlyJobs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.ya?ml#[A-Za-z0-9_-]+$" } }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageManager", "runtimes", "browsers"],
      "properties": {
        "packageManager": { "enum": ["pnpm", "npm", "yarn", "bun", "pip", "poetry", "uv", "go", "cargo", "other"] },
        "runtimes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" } },
        "browsers": { "type": "array", "items": { "enum": ["chromium", "firefox", "webkit"] } },
        "monorepoTool": { "enum": ["turbo", "nx", "lerna", "none"] }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nice", "openFiles"],
      "properties": {
        "nice": { "type": "integer", "minimum": 0, "maximum": 19 },
        "openFiles": { "type": "integer", "minimum": 1024 },
        "nextBuildCpus": { "type": "integer", "minimum": 1 },
        "turboConcurrency": { "type": "integer", "minimum": 1 },
        "jestMaxWorkers": { "type": "integer", "minimum": 1 },
        "playwrightWorkers": { "type": "integer", "minimum": 1 }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "version", "port", "install"],
        "properties": {
          "kind": { "enum": ["postgres", "redis"] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
          "port": { "type": "integer", "minimum": 1024, "maximum": 49151 },
          "install": { "enum": ["source", "package"], "description": "source = built into the tenant home (no shared package manager); package = the distro's versioned package (Linux only)." },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "ports": {
      "description": "Every TCP port the tenant's jobs listen on (app servers + services). Hooks require them free; network isolation allows only these on loopback.",
      "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1024, "maximum": 49151 }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "privateRanges", "probeTargets", "forbiddenReadPaths"],
      "properties": {
        "network": { "type": "boolean", "description": "pf (macOS) / nftables (Linux) rules scoped to the tenant uid: own loopback ports, DNS and the internet only." },
        "privateRanges": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f:.]+/[0-9]{1,3}$" } },
        "probeTargets": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f:.\\[\\]]+:[0-9]{1,5}$" }, "description": "host:port pairs the tenant must NOT reach; checked before every job." },
        "forbiddenReadPaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } }
      }
    },
    "cotenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "yieldBudgetSeconds", "pollSeconds"],
      "properties": {
        "mode": { "enum": ["none", "marker-dir", "command"] },
        "markerDir": { "type": "string", "pattern": "^/" },
        "pidGlob": { "type": "string", "description": "Marker files judged live iff their JSON pid is a live process (any user). e.g. device.*.busy" },
        "epochFile": { "type": "string", "description": "Intent marker judged live iff 0 <= now - epoch <= epochBoundSeconds. e.g. device.want" },
        "epochBoundSeconds": { "type": "integer", "minimum": 1 },
        "command": { "type": "string", "description": "mode=command: exit 0 = clear, non-zero = busy. Run as the tenant user, read-only." },
        "yieldBudgetSeconds": { "type": "integer", "minimum": 0 },
        "pollSeconds": { "type": "integer", "minimum": 1 },
        "swapYieldMb": { "type": "integer", "minimum": 0, "description": "Also wait while swap used exceeds this (0 = off). Still bounded by the budget, fail-open." },
        "workerProbe": {
          "type": "object", "additionalProperties": false, "required": ["user", "pattern"],
          "properties": { "user": { "type": "string" }, "pattern": { "type": "string" } },
          "description": "Counted (never acted on) in the job banner: another tenant's CI jobs that take no marker."
        }
      }
    },
    "diskFloorGb": { "type": "integer", "minimum": 1 },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cron", "homeMaxGb", "diagRetentionDays"],
      "properties": {
        "cron": { "type": "string", "pattern": "^[0-9*/,-]+( [0-9*/,-]+){4}$" },
        "homeMaxGb": { "type": "integer", "minimum": 1 },
        "diagRetentionDays": { "type": "integer", "minimum": 1 }
      }
    },
    "secretsPolicy": { "enum": ["none", "allow-listed"], "description": "none = no `secrets.` in any self-hosted-capable workflow (default)." },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "thresholdMinutes", "reapClosedPrs"],
      "properties": {
        "placement": { "enum": ["cloud-routine", "hosted-cron", "laptop-task", "watcher-user", "none"] },
        "thresholdMinutes": { "type": "integer", "minimum": 5 },
        "reapClosedPrs": { "type": "boolean" },
        "issueTitle": { "type": "string" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineAdmin", "repoAdmin"],
      "properties": {
        "machineAdmin": { "type": "string", "description": "A role description, never a person's name: e.g. 'you', 'your IT admin'." },
        "repoAdmin": { "type": "string" }
      }
    },
    "optimizations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "target"],
        "properties": { "id": { "type": "string", "pattern": "^[CBI][0-9]{1,2}$" }, "target": { "enum": ["optimise-pr", "runner-pr", "owner-checklist"] } }
      }
    }
  }
}
