<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- /Library/LaunchDaemons/{{derived.firewallLabel}}.plist (root:wheel 0644): re-applies the pf anchor
     of tenant {{tenant.user}} at boot and every 300 s. StartInterval only: calendar timers can fire hours late. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{derived.firewallLabel}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{tenant.rootDir}}/pf-load.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>{{tenant.rootDir}}/pf-load.log</string>
  <key>StandardErrorPath</key>
  <string>{{tenant.rootDir}}/pf-load.log</string>
</dict>
</plist>
