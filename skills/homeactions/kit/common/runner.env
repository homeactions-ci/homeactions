LANG=en_US.UTF-8
TZ=UTC
TMPDIR={{derived.tmpDir}}/
PLAYWRIGHT_BROWSERS_PATH={{derived.cacheDir}}/ms-playwright
npm_config_cache={{derived.cacheDir}}/npm
npm_config_store_dir={{derived.cacheDir}}/pnpm-store
pnpm_config_store_dir={{derived.cacheDir}}/pnpm-store
XDG_CACHE_HOME={{derived.cacheDir}}/xdg
{{#if derived.hasPostgres}}HOMEACTIONS_PG_BIN={{derived.postgres.bin}}
HOMEACTIONS_PG_PORT={{derived.postgres.port}}
{{/if}}{{#if derived.hasRedis}}HOMEACTIONS_REDIS_BIN={{derived.redis.bin}}
HOMEACTIONS_REDIS_PORT={{derived.redis.port}}
{{/if}}{{#each derived.capsEnv}}{{this.name}}={{this.value}}
{{/each}}ACTIONS_RUNNER_HOOK_JOB_STARTED={{derived.hooksDir}}/job-started.sh
ACTIONS_RUNNER_HOOK_JOB_COMPLETED={{derived.hooksDir}}/job-completed.sh
