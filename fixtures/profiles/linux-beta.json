    },
    "browsers": [
      "chromium",
      "firefox"
    ],
    "monorepoTool": "none"
  },
  "caps": {
    "nice": 10,
    "openFiles": 65536,
    "playwrightWorkers": 2
  },
  "services": [
    {
      "kind": "postgres",
      "version": "16.6",
      "port": 5452,
      "install": "package"
    },
    {
      "kind": "redis",
      "version": "7.4.12",
      "port": 6391,
      "install": "source",
      "sourceSha256": "56588ee1648539556f2b6cf4e873e3734afbbe40fa952fec2fcd6b6d7dae2924"
    }
  ],
  "ports": [
    8000,
    5452,
    6391
  ],
